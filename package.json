{
  "name": "agenticscale",
  "version": "1.0.0",
  "description": "Continuous Safety Assurance Platform for AI Agents",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=agenticscale",
    "db:migrate:local": "wrangler d1 execute agenticscale-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute agenticscale-db --local --file=./seed.sql",
    "db:migrate:remote": "wrangler d1 execute agenticscale-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute agenticscale-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.7.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.86.0"
  }
}
